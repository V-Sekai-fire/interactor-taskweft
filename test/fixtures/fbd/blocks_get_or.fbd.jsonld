{
  "@context": {
    "@version": 1.1,
    "fbd": "https://project-agrafe.github.io/ns/fbd#",
    "sfc":   { "@id": "fbd:name" },
    "descr": { "@id": "fbd:description" },
    "V":     { "@id": "fbd:internalVariables", "@container": "@index" },
    "S":     { "@id": "fbd:steps",             "@container": "@list"  },
    "^":  "fbd:InitialStep",
    "&>": "fbd:AndDivergence",
    "&<": "fbd:AndConvergence",
    "|>": "fbd:OrDivergence",
    "|<": "fbd:OrConvergence"
  },
  "@type": "fbd:SFC",
  "sfc": "blocks_get_or",
  "descr": "Minimal OR-divergence fixture: after `find`, the persona either `pickup_from_table` (when the block is on the table) or `unstack` (otherwise). Direct analogue of blocks_world's `get` method with two alternatives.",
  "V": { "found": 0, "picked": 0, "unstacked": 0, "done": 0 },
  "S": [
    ["^"],
    ["find",              "",         "V.found:=1",      "1h"],
    ["|>", "pickup_from_table", "unstack"],
    ["pickup_from_table", "X.found", "V.picked:=1",    "1h"],
    ["unstack",           "X.found", "V.unstacked:=1", "1h"],
    ["|<"],
    ["mark_done",         "",         "V.done:=1",       "1h"]
  ]
}
